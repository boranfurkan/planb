# Local development: a Gemini API key from aistudio.google.com
GEMINI_API_KEY=

# Deployed (Cloud Run, billed to Google Cloud): use Vertex AI instead of an API key
# GOOGLE_GENAI_USE_ENTERPRISE=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

# Optional
# PLANB_MODEL=gemini-3.8-flash
# TFL_APP_KEY=            # raises TfL's anonymous rate limit
